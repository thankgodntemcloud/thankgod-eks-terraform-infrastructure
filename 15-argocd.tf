# ---- Argo CD at https://<argocd_hostname> through the NGINX ingress ----

resource "helm_release" "argocd" {
  name             = "argocd"
  repository       = "https://argoproj.github.io/argo-helm"
  chart            = "argo-cd"
  version          = var.argocd_chart_version
  namespace        = "argocd"
  create_namespace = true

  values = [yamlencode({
    global = {
      domain = var.argocd_hostname
    }

    configs = {
      params = {
        # NGINX terminates TLS, so argocd-server serves plain HTTP inside the cluster
        "server.insecure" = true
      }
      cm = {
        # Health check for Argo CD's own Applications, so an "app of apps"
        # waits for each child app to be Healthy before the next sync wave
        "resource.customizations.health.argoproj.io_Application" = <<-EOT
          hs = {}
          hs.status = "Progressing"
          hs.message = ""
          if obj.status ~= nil then
            if obj.status.health ~= nil then
              hs.status = obj.status.health.status
              if obj.status.health.message ~= nil then
                hs.message = obj.status.health.message
              end
            end
          end
          return hs
        EOT
      }
    }

    server = {
      ingress = {
        # The chart does NOT create the Ingress. Create it yourself after the DNS
        # record exists: kubectl apply -f manifests/argocd-ingress.yaml
        enabled = false
      }
    }
  })]

  depends_on = [
    helm_release.nginx_ingress,
    helm_release.cluster_issuer,
  ]
}

# Initial admin password generated by Argo CD on first install
data "kubernetes_secret_v1" "argocd_initial_admin" {
  metadata {
    name      = "argocd-initial-admin-secret"
    namespace = helm_release.argocd.namespace
  }

  depends_on = [helm_release.argocd]
}
